# Handy reference: https://github.com/github/gitignore/

# === VirtualDesktop Specific ===
# Directories created by the application at run-time
data/


# === Eclipse ===
.project
.classpath
.settings/


# === Maven :: https://github.com/github/gitignore/blob/main/Maven.gitignore 
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
# https://maven.apache.org/wrapper/#usage-without-binary-jar
.mvn/wrapper/maven-wrapper.jar

# === VisualStudio/Cursor
# Keep project-wide config, ignore personal dev clutter
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json


# === Java :: https://github.com/github/gitignore/blob/main/Java.gitignore
# These probably aren't necessary as they are covered by most preceding
# rules but they don't hurt.

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

