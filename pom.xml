      <releases>
        <enabled>false</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </repository>

    <!-- Local project repository for non-central JARs -->
    <repository>
      <id>virtualdesktop_project.local</id>
      <name>virtualdesktop_project</name>
      <url>file:///${project.basedir}/repo/</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
