demoJFreeChart() {
    JFreeChartDemo demo = JFreeChartDemo.createMainUI(null);

    DesktopManager.get().createVApp(demo.getPanel(), "JPreeChart");

    JPreeChart pre = new JPreeChart();
    pre.decorate(demo.getChart());

    print("demoJFreeChart has been defined");
    return this;
}

