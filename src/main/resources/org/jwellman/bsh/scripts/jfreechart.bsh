import org.jwellman.virtualdesktop.*;
import org.jwellman.jfreechart.*;
import org.jwellman.jfreechart.editor.*;
import org.jwellman.jpreechart.*;

import org.jfree.chart.*;
import org.jfree.chart.demo.*;
import org.jfree.chart.plot.*;
import org.jfree.chart.renderer.xy.*;
import org.jfree.chart.renderer.xy.*;
import org.jfree.data.category.*;
import org.jfree.chart.ui.*; // needed for runtime manipulation
import org.jfree.chart.title.*; // needed for runtime manipulation


jfc() {

    // for convenience, show the api in the beanshell class browser
    jvd.browser.go2("org.jfree.chart.JFreeChart");

    Color[] paint = new Color[] {
            Color.decode("#CD4E3C"), // red
            Color.decode("#579340"), // green
            Color.decode("#5582A6"), // blue
            Color.decode("#CA4FCC"), // magenta
            Color.decode("#7D6EC7"), // purple
            Color.decode("#A87829")  // brown
        };

    // Let’s start by using DefaultCategoryDataset to create a dataset for our graph:
    DefaultCategoryDataset dataset = new DefaultCategoryDataset();
    dataset.addValue(200, "Laptops", "January");
    dataset.addValue(150, "Laptops", "February");
    dataset.addValue(180, "Laptops", "March");
    dataset.addValue(260, "Laptops", "April");
    dataset.addValue(300, "Laptops", "May");

    // Create a Random object
    var random = new Random();

    // Generate a random integer within the specified range
    // The formula is: random.nextInt(max - min + 1) + min
    // int randomNumber = random.nextInt(max - min + 1) + min;
    addDataset(category) {
        dataset.addValue(random.nextInt(400 - 50 + 1) + 50, category, "January");
        dataset.addValue(random.nextInt(400 - 50 + 1) + 50, category, "February");
        dataset.addValue(random.nextInt(400 - 50 + 1) + 50, category, "March");
        dataset.addValue(random.nextInt(400 - 50 + 1) + 50, category, "April");
        dataset.addValue(random.nextInt(400 - 50 + 1) + 50, category, "May");        
    }

    addDataset("Cell Phones");


    // Now, we can create a JFreeChart object that uses the previous dataset to plot a bar chart.
    // The ChartFactory.createLineChart method takes the chart title, the x-axis and y-axis labels, and the dataset as parameters:
    JFreeChart chart = ChartFactory.createBarChart(
        "Monthly Sales",
        "Month",
        "Sales",
        dataset);

    // Create a new TextTitle for the subtitle
    var subtitle = new TextTitle("This is a subtitle", 
                                       new Font("SansSerif", Font.PLAIN, 24), 
                                       Color.DARK_GRAY, 
                                       RectangleEdge.TOP, 
                                       org.jfree.chart.ui.HorizontalAlignment.CENTER, 
                                       org.jfree.chart.ui.VerticalAlignment.BOTTOM, 
                                       org.jfree.chart.ui.RectangleInsets.ZERO_INSETS);
    
    // Add the subtitle to the chart
    chart.addSubtitle(subtitle);

    // Next, a ChartPanel object is essential for displaying our chart within a Swing component. 
    ChartPanel chartPanel = new ChartPanel(chart);
    // put the chart (via the chartpanel) on the desktop
    DesktopManager.get().createVApp(chartPanel, "Baeldung Bar Chart");

    // Closure/object to create the chart editor and put it on the desktop
    createUI() {
        var p = new JFCEditor(chart);
        DesktopManager.get().createVApp(p, "jfc" );

        return this;
    }

    // Closure/object to create some usable painters
    createPainters() {
        var stdbarpainter = new org.jfree.chart.renderer.category.StandardBarPainter();
        return this;
    }

    // Create the user interface (for the editor)
    var container = createUI();

    // Create utility objects to be used ad hoc
    var pre = new JPreeChart();
    var painters = createPainters();

    return this;
}
jfc = jfc();

