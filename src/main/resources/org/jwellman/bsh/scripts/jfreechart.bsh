demoAnyChart() {

    test = "uninitialized"; 

    createChart() {
        test = new AnyChartTest();
        test.createChart();
        ChartPanel panel = new ChartPanel(test.chart);
        DesktopManager.get().createVApp(panel, "Stacked Horizontal Bar Chart");
    }

    return this;
}

