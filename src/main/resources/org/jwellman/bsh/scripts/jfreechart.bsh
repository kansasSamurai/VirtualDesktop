// Example of how to create a common UI framework:
// JPanel containing JTree in the WEST.
// the followup shows how to create a vapp
// and then update the jtree with a new datamodel.
jfc() {

    pre = new JPreeChart();

    createUI() {
        tree = new JTree();

        p = new JPanel(new BorderLayout());
        p.add(tree, BorderLayout.WEST);

        return this;
    }

    container = createUI();

    return this;
}
jfc = jfc();

// 
DesktopManager.get().createVApp(jfc.container.p, "jfc" );

// 'cn' is an existing variable that is a ChartNode
jfc.container.tree.getModel().setRoot(cn);

