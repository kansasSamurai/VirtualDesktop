        bar.bkgrd = new Color(149, 188, 221, 32);
        if (control.horizontal) {
            g2d.translate(50, 50);
        } else {
            // translate the origin FIRST
            g2d.translate(50, 600);
            // ... then, set the rotation
            g2d.rotate(-Math.PI/2);
        }
        worldPoint = object();
        textPoints.add(worldPoint);
        drawBar(g2d, area, bar, worldPoint);

        bar.x = 50; bar.y = 150; bar.width = 100; bar.value = "350"; bar.label = "2020";
//        bar.dark = new Color(0x26CCD0);
//        bar.light = new Color(0x4DD2D9);
        bar.dark = palette[ci]; // new Color(0x95BCDD);
        bar.light = p2[ci++]; // new Color(0x9FC2DE);
        bar.cthru = new Color(46, 204, 211, 64);
        bar.bkgrd = new Color(46, 204, 211, 32);
        g2d.translate(0, control.spacing);
        worldPoint = object();
        textPoints.add(worldPoint);
        drawBar(g2d, area, bar, worldPoint);

        bar.x = 50; bar.y = 150; bar.width = 200; bar.value = "700"; bar.label = "2021";
//        bar.dark = new Color(0x28B0D8);
//        bar.light = new Color(0x3AB6DC);
        bar.dark = palette[ci]; // new Color(0x95BCDD);
        bar.light = p2[ci++]; // new Color(0x9FC2DE);
        bar.cthru = new Color(91, 170, 239, 64);
        bar.bkgrd = new Color(91, 170, 239, 32);
        g2d.translate(0, control.spacing);
        worldPoint = object();
        textPoints.add(worldPoint);
