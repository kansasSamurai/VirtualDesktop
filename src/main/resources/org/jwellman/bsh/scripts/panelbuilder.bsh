p.proxy = new Drawable() {

    bar() {
        max = 300;
        width = 100;
        height = 50;

        // x and y might eventually be useful but in the current demo, they are not used
        // x = 0; y = 0;
        value = "350";
        label = "2020";
        
        dark = new Color(0x26CCD0);
        light = new Color(0x4DD2D9);
        cthru = new Color(46, 204, 211, 64);
        bkgrd = new Color(46, 204, 211, 32);
        shadow = new Color(0, 0, 0, 32);

        return this;
    }
    

    /* Note: As with Java2D screen coordinates, bars start at 0,0
     *  which is either the bottom left (vertical bar) or 
     *  top left (horizontal bar).
     * 
     * This bar logic is drawn horizontal so "width" actually corresponds to "visual height".
     */
    drawBar(g2d, area, bar, btnpoint) {

        var inset = 5; // inset of actual bar; applies to both sides
        var height = bar.height-(inset*2); // height of the colored bar
        var midheight = bar.height / 2; // centerline
        var width = bar.width * 2; // scale for this particular bar

        var cap = new Ellipse2D.Double(bar.width-25, 0, 50, 50);
        var capsh = new Ellipse2D.Double(bar.width-25-3, 0, 50, 50);
        var halo = new Ellipse2D.Double(bar.width-25-10, 0-10, 50+20, 50+20);

        var bwidth = 40; var bradius = bwidth / 2;
        var button = new Ellipse2D.Double(bar.max - bradius, (bar.height/2)-(40/2), bwidth, bwidth);

        // Layer 0 / bar background
        g2d.setPaint(control.barBackground);
        g2d.fillRect(0, 0, bar.max, bar.height);
        g2d.fillArc(bar.max-25, 0, 50, 50, 270, 180); // endcap

        // Layer 2 / bars
        // Create the GradientPaint object
        // GradientPaint gradientPaint = new GradientPaint(startX, startY, color1, endX, endY, color2);
        var g1 = new GradientPaint(0, 0+inset, bar.dark, 0, midheight, bar.light);
        var g2 = new GradientPaint(0, midheight, bar.light, 0, bar.height+inset, bar.dark);

        // g2d.setPaint(bar.dark);
        g2d.setPaint(g1);
        g2d.fillRect(0, 0+inset, width, midheight-inset);
        g2d.setPaint(g2);
        g2d.fillRect(0, midheight, width, midheight-inset);

        // Layer 5 / button
        g2d.setPaint(Color.lightGray); 
        g2d.fill(button);

        // button text (value)
        if (control.horizontal) {
            // we can just paint text here because we're already horizontal
            g2d.setPaint(Color.black); // (control.barBackground);
            g2d.setFont(control.font);
            drawCenteredStringPrecise(g2d, bar.value, bar.max, bar.height/2);        
        } else {
            // we can just paint text here because we're already horizontal
            g2d.setPaint(bar.dark);
            g2d.setFont(control.font);
            drawCenteredStringPrecise(g2d, bar.value, bar.width, bar.height/2);        
        }
    }

    drawBar_works(g2d, area, bar, btnpoint) {

        cap = new Ellipse2D.Double(bar.width-25, 0, 50, 50);
        capsh = new Ellipse2D.Double(bar.width-25-3, 0, 50, 50);
        halo = new Ellipse2D.Double(bar.width-25-10, 0-10, 50+20, 50+20);
        button = new Ellipse2D.Double(bar.width-40/2, (bar.height/2)-(40/2), 40, 40);

        // Layer 0 / bar background
        g2d.setPaint(bar.bkgrd);
        g2d.fillRect(0, 0, bar.max, bar.height);
        g2d.fillArc(bar.max-25, 0, 50, 50, 270, 180);
        
        // Layer 1 / halo
        if (control.drawHalo) {
            g2d.setPaint(bar.cthru);
            g2d.fill(halo);
        }

        // Layer 2 / bars
        g2d.setPaint(bar.dark);
        g2d.fillRect(0, 0, bar.width, bar.height);

        g2d.setPaint(bar.light);
        g2d.fillRect(0,0+(bar.height/2),bar.width, bar.height/2);

        // Layer 3 / shadow
        g2d.setPaint(bar.shadow);
        g2d.fill(capsh);

        // Layer 4 / cap
        g2d.setPaint(bar.light);
        g2d.fill(cap);

        // Layer 5 / button
        g2d.setPaint(Color.white); // TODO  bar.button
        g2d.fill(button);

        // label Text
        g2d.setPaint(Color.white);
        g2d.setFont(control.labelFont);
        drawLeftCenteredStringPrecise(g2d, bar.label, 0+control.labelOffset, bar.height/2);        

        // Button Text (always horizontal)
//        Point2D c = new Point2D.Double(halo.getCenterX(), halo.getCenterY());
//        Point2D abs = g2d.getTransform().inverseTransform(c, null);
//        print(abs.getX()); print(abs.getY());

        if (control.horizontal) {
            // we can just paint text here because we're already horizontal
            g2d.setPaint(bar.dark);
            g2d.setFont(control.font);
            drawCenteredStringPrecise(g2d, bar.value, bar.width, bar.height/2);        
        } else {
            // capture the data necessary to draw the text later...            
            btnpoint.value = bar.value;
            btnpoint.color = bar.dark;
            btnpoint.point = new Point2D.Double();
            captureCurrentPosition(g2d, bar.width, bar.height/2, btnpoint.point);
        }
        
    }

    // private Point2D 
    captureCurrentPosition(Graphics2D g2d, double localX, double localY, Point2D dest) {
        // Create a point in local coordinates
        Point2D localPoint = new Point2D.Double(localX, localY);
        
        // Transform it to world coordinates
        Point2D worldPoint = (dest != null) ? dest : new Point2D.Double();
        g2d.getTransform().transform(localPoint, dest);
        
        return worldPoint;
    }

    draw(g2d, area) {

        if (control.drawGrid) {
            g2d.setPaint(Color.darkGray);
            
            // Draw horizontal lines
            for (int y = 0; y < control.height; y += control.gridSize) {
                g2d.drawLine(0, y, control.width, y);
            }
    
            // Draw vertical lines
            for (int x = 0; x < control.width; x += control.gridSize) {
                g2d.drawLine(x, 0, x, control.height);
            }
            
        } else {
            g2d.setPaint(Color.white);
            g2d.fillRect(0, 0, control.width, control.height);            
        }


        var bar = bar();
