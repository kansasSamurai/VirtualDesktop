        var textPoints = new ArrayList(); // actually now more than just points; i.e. {point, color, ...}

        var palette = parseColors("#A7565B, #CD9E7F, #EFC898, #C5D27C, #99B288, #5F7E73, #70A4B8, #4D748D, #5E5492, #7B4D86");
        var p2 = parseColors("#DF8274, #F7B796, #FBD4A8, #DDED8F, #AEDC8D, #7EB0A2, #81C5E3, #6FA2C6, #8172D0, #A75BB3");
        int ci = 0; // current index of palette(color)

        bar.x = 50; bar.y = 150; bar.width = 130; bar.value = "410"; bar.label = "2019";
        bar.dark = palette[ci]; // new Color(0x95BCDD);
        bar.light = p2[ci++]; // new Color(0x9FC2DE);
