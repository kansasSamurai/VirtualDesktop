        textPoints.add(worldPoint);
        drawBar(g2d, area, bar, worldPoint);

        bar.x = 50; bar.y = 150; bar.width = 250; bar.value = "875"; bar.label = "2023";
//        bar.dark = new Color(0x959FDA);
//        bar.light = new Color(0x9FA9DE);
        bar.dark = palette[ci]; // new Color(0x95BCDD);
