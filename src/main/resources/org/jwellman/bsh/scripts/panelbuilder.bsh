        bar.dark = palette[ci]; // new Color(0x95BCDD);
        bar.light = p2[ci++]; // new Color(0x9FC2DE);
        bar.cthru = new Color(73, 159, 236, 64);
        bar.bkgrd = new Color(73, 159, 236, 32);
        g2d.translate(0, control.spacing);
