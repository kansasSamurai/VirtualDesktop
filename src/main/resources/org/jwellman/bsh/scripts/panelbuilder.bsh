// I haven't tested the following yet but it should 
// be mostly right:
panelbuilder() {

    void add(container, component) {
        container.add(component);
    }

    void add(container, component, constraint) {
        container.add(component, constraint);
    }

    return this;
}

pb = panelbuilder();


