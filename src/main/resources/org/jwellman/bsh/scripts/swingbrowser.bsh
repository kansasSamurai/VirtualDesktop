// Example Interface
public class SwingComponentsPanel extends JPanel {

    public SwingComponentsPanel() {
        // Set a layout manager for the panel
        setLayout(new FlowLayout(FlowLayout.LEFT, 10, 10)); // FlowLayout with spacing

        // 1. JButton
        JButton myButton = new JButton("Click Me!");
        myButton.addActionListener(new ActionListener() {
            public void actionPerformed(ActionEvent e) {
                JOptionPane.showMessageDialog(SwingComponentsPanel.this, "Button Clicked!");
            }
        });
        add(myButton);

        // 2. JLabel
        JLabel myLabel = new JLabel("Enter your name:");
        add(myLabel);

        // 3. JTextField
        JTextField myTextField = new JTextField(20); // 20 columns wide
        add(myTextField);

        // 4. JCheckBox
        JCheckBox myCheckBox = new JCheckBox("Agree to terms");
        myCheckBox.addActionListener(new ActionListener() {
            public void actionPerformed(ActionEvent e) {
                if (myCheckBox.isSelected()) {
                    System.out.println("Checkbox selected.");
                } else {
                    System.out.println("Checkbox deselected.");
                }
            }
        });
        add(myCheckBox);

        // Set a border for visual separation (optional)
        setBorder(BorderFactory.createTitledBorder("Example Components"));
    }


}

y.ui = new SwingComponentsPanel();
y.panel.add(y.ui, BorderLayout.CENTER);
y.setModel(y.ui);






