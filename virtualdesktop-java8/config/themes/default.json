{
  "name": "default",
  "displayName": "Default Theme",
  "description": "Default VirtualDesktop theme with standard sizes and light colors",
  "version": "1.0.0",

  "iconSizes": {
    "small": 16,
    "menu": 18,
    "toolbar": 24,
    "large": 48,
    "xlarge": 64
  },

  "palette": {
    "blue50": "#E3F2FD",
    "blue100": "#BBDEFB",
    "blue500": "#2196F3",
    "blue700": "#1976D2",
    "blue900": "#0D47A1",

    "gray50": "#FAFAFA",
    "gray100": "#F5F5F5",
    "gray300": "#E0E0E0",
    "gray500": "#9E9E9E",
    "gray700": "#616161",
    "gray900": "#212121",

    "red500": "#F44336",
    "orange500": "#FF9800",
    "green500": "#4CAF50",
    "yellow500": "#FFEB3B",

    "white": "#FFFFFF",
    "black": "#000000",
    "transparent": "rgba(0,0,0,0)"
  },

  "colors": {
    "background": {
      "desktop": "blue900",
      "window": "white",
      "panel": "gray100",
      "menubar": "gray100",
      "toolbar": "gray50"
    },

    "foreground": {
      "primary": "gray900",
      "secondary": "gray700",
      "disabled": "gray500",
      "inverse": "white"
    },

    "border": {
      "default": "gray300",
      "focus": "blue500",
      "disabled": "gray300"
    },

    "icon": {
      "default": "gray700",
      "menu": "gray700",
      "toolbar": "gray700",
      "desktop": "white",
      "disabled": "gray500"
    },

    "status": {
      "info": "blue500",
      "success": "green500",
      "warning": "orange500",
      "error": "red500"
    }
  },

  "components": {
    "menuIcon": {
      "foreground": "icon.menu",
      "background": "transparent"
    },

    "toolbarIcon": {
      "foreground": "icon.toolbar",
      "background": "transparent",
      "hoverBackground": "gray100"
    },

    "desktopIcon": {
      "foreground": "icon.desktop",
      "background": "transparent",
      "labelColor": "foreground.inverse",
      "labelBackground": "rgba(0,0,0,0.3)"
    },

    "listIcon": {
      "foreground": "icon.default",
      "background": "transparent"
    }
  },

  "fonts": {
    "base": {
      "family": "Dialog",
      "style": "PLAIN",
      "size": 12
    },
    "title": {
      "family": "Dialog",
      "style": "BOLD",
      "size": 14
    },
    "menu": {
      "family": "Dialog",
      "style": "PLAIN",
      "size": 12
    }
  },

  "iconMetadata": {
    "home156": {
      "colorable": false,
      "type": "raster"
    },
    "calendar168": {
      "colorable": false,
      "type": "raster"
    },
    "document176": {
      "colorable": false,
      "type": "raster"
    },
    "rubbish1": {
      "colorable": false,
      "type": "raster"
    },
    "winking18": {
      "colorable": false,
      "type": "raster"
    }
  }
}
