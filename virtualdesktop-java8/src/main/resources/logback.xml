<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- tail pattern -->
            <pattern>%d{HH:mm:ss} [%-20.20logger{0}: %-5level : %msg [%thread]%n</pattern>
        </encoder>
    </appender>

    <!-- default:
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
     -->
    <!-- tail pattern:
        <pattern>%d{HH:mm:ss} %-20.20logger{0} %-5level %msg [%thread]%n</pattern>
        <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %msg [%thread] \(%class{0}.java:%line\)%n</pattern>
     -->

    <!-- Root level -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- Application packages -->
    <logger name="org.jwellman" level="DEBUG"/>

</configuration>
