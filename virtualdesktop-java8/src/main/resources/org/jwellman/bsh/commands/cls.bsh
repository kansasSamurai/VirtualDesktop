/**
    cls() - Clears the console (just like DOS/Unix/Linux)

    This command requires/assumes the JVD framework as it needs access
    to the console itself via the '_console' variable.

    Primary path: call clear() which both JConsole (JVD) and GenericConsole expose.
    Fallback: reach into the textpane directly for non-JVD JConsole instances
    that predate the clear() method.
*/

cls() {
    if (void == _console) {
        print("ERR: _console is undefined");
        return;
    }
    // Primary: both JConsole (JVD) and GenericConsole expose clear().
    // Fallback: older or third-party JConsole instances that lack clear()
    // still expose textpane, so fall back to direct setText access.
    try {
        _console.clear();
    } catch (Exception e) {
        _console.textpane.setText("");
    }
    printBanner();
}
