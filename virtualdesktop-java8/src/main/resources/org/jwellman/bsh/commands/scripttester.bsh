/**
 * Script Tester Tool - Step-by-step BeanShell script execution with visual feedback.
 *
 * A tool for debugging and stepping through BeanShell scripts one line at a time.
 * Provides visual feedback for completed, current, pending, and error states.
 *
 * Usage:
 *   scripttester();                    // Opens with default title
 *   scripttester("My Test Script");    // Opens with custom title
 *
 * Features:
 *   - Step button: Execute one line at a time
 *   - Reset button: Restart execution from beginning
 *   - Load button: Load a script from file
 *   - Paste button: Load script from system clipboard
 *   - Swap View button: Toggle between table and two-panel views
 */

import javax.swing.*;
import javax.swing.table.*;
import javax.swing.filechooser.FileNameExtensionFilter;
import java.awt.*;
import java.awt.event.*;
import java.awt.datatransfer.*;
import java.io.*;
import java.util.ArrayList;

import org.jwellman.virtualdesktop.DesktopManager;
import org.jwellman.virtualdesktop.bsh.BeanShellService;

// Status constants
String STATUS_PENDING = "pending";
String STATUS_CURRENT = "current";
String STATUS_COMPLETED = "completed";
String STATUS_ERROR = "error";

/**
 * Data model for each script line.
 */
public class ScriptLine {
    int lineNumber;
    String text;
    String status;
    String errorMessage;

    public ScriptLine(int lineNumber, String text) {
        this.lineNumber = lineNumber;
        this.text = text;
        this.status = STATUS_PENDING;
        this.errorMessage = null;
    }

    public String toString() {
        return lineNumber + ": " + text + " [" + status + "]";
    }
}

/**
 * Table model for the script lines.
 */
public class ScriptTableModel extends AbstractTableModel {
    private ArrayList lines;
    private String[] columnNames = {"Status", "#", "Code"};

    public ScriptTableModel(ArrayList lines) {
        this.lines = lines;
    }

    public int getRowCount() {
        return lines.size();
    }

    public int getColumnCount() {
        return 3;
    }

    public String getColumnName(int column) {
        return columnNames[column];
    }

    public Object getValueAt(int row, int column) {
        ScriptLine line = (ScriptLine) lines.get(row);
        switch (column) {
            case 0: return line.status;
            case 1: return Integer.valueOf(line.lineNumber);
            case 2: return line.text;
            default: return "";
        }
    }

    public Class getColumnClass(int column) {
        switch (column) {
            case 0: return String.class;
            case 1: return Integer.class;
            case 2: return String.class;
            default: return Object.class;
        }
    }

    public void fireDataChanged() {
        fireTableDataChanged();
    }
}

/**
 * Custom cell renderer for the status column - shows icons.
 */
public class StatusCellRenderer extends DefaultTableCellRenderer {

    public Component getTableCellRendererComponent(JTable table, Object value,
            boolean isSelected, boolean hasFocus, int row, int column) {

        JLabel label = (JLabel) super.getTableCellRendererComponent(
            table, "", isSelected, hasFocus, row, column);

        String status = (String) value;
        label.setHorizontalAlignment(SwingConstants.CENTER);

        // Use text symbols for status (works across all platforms)
        if (STATUS_COMPLETED.equals(status)) {
            label.setText("\u2713"); // checkmark
            label.setForeground(new Color(0, 128, 0)); // green
        } else if (STATUS_CURRENT.equals(status)) {
            label.setText("\u25B6"); // right-pointing triangle (play)
            label.setForeground(new Color(0, 0, 200)); // blue
        } else if (STATUS_ERROR.equals(status)) {
            label.setText("\u2717"); // X mark
            label.setForeground(Color.RED);
        } else {
            label.setText(""); // pending - no symbol
            label.setForeground(Color.GRAY);
        }

        return label;
    }
}

/**
 * Custom cell renderer for the code column - shows visual state.
 */
public class CodeCellRenderer extends DefaultTableCellRenderer {
    private Font normalFont;
    private Font italicFont;
    private Font monoFont;

    public CodeCellRenderer() {
        monoFont = new Font(Font.MONOSPACED, Font.PLAIN, 12);
        normalFont = monoFont;
        italicFont = new Font(Font.MONOSPACED, Font.ITALIC, 12);
    }

    public Component getTableCellRendererComponent(JTable table, Object value,
            boolean isSelected, boolean hasFocus, int row, int column) {

        JLabel label = (JLabel) super.getTableCellRendererComponent(
            table, value, isSelected, hasFocus, row, column);

        // Get the status from column 0
        String status = (String) table.getValueAt(row, 0);

        label.setFont(monoFont);

        if (!isSelected) {
            if (STATUS_COMPLETED.equals(status)) {
                label.setBackground(new Color(230, 230, 230)); // light gray
                label.setFont(italicFont);
                label.setForeground(Color.DARK_GRAY);
            } else if (STATUS_CURRENT.equals(status)) {
                label.setBackground(new Color(255, 255, 180)); // yellow highlight
                label.setForeground(Color.BLACK);
            } else if (STATUS_ERROR.equals(status)) {
                label.setBackground(new Color(255, 200, 200)); // light red
                label.setForeground(Color.BLACK);
            } else {
                label.setBackground(Color.WHITE);
                label.setForeground(Color.BLACK);
            }
        }

        return label;
    }
}

/**
 * Custom cell renderer for the line number column.
 */
public class LineNumberCellRenderer extends DefaultTableCellRenderer {

    public LineNumberCellRenderer() {
        setHorizontalAlignment(SwingConstants.RIGHT);
    }

    public Component getTableCellRendererComponent(JTable table, Object value,
            boolean isSelected, boolean hasFocus, int row, int column) {

        JLabel label = (JLabel) super.getTableCellRendererComponent(
            table, value, isSelected, hasFocus, row, column);

        // Get the status from column 0
        String status = (String) table.getValueAt(row, 0);

        label.setHorizontalAlignment(SwingConstants.RIGHT);

        if (!isSelected) {
            if (STATUS_COMPLETED.equals(status)) {
                label.setBackground(new Color(230, 230, 230));
                label.setForeground(Color.DARK_GRAY);
            } else if (STATUS_CURRENT.equals(status)) {
                label.setBackground(new Color(255, 255, 180));
                label.setForeground(Color.BLACK);
            } else if (STATUS_ERROR.equals(status)) {
                label.setBackground(new Color(255, 200, 200));
                label.setForeground(Color.BLACK);
            } else {
                label.setBackground(Color.WHITE);
                label.setForeground(Color.GRAY);
            }
        }

        return label;
    }
}


/**
 * No-args version - defaults title to 'Script Tester'
 */
scripttester() {
    scripttester("Script Tester");
}

/**
 * Main scripttester implementation.
 *
 * @param title The title for the container
 */
scripttester(String title) {

    if (void == jvd || void == jvd.app) {
        print("This requires jvd.app; see jvdClassBrowser.bsh");
        return;
    }

    // === State Variables ===
    // Capture 'this' reference for use in callbacks (BeanShell quirk)
    self = this;

    self.lines = new ArrayList();       // List of ScriptLine
    self.currentIndex = 0;              // Next line to execute
    self.tableModel = null;             // Table model
    self.table = null;                  // JTable
    self.viewPanel = null;              // Current view panel
    self.isTableView = true;            // Track current view mode

    // Two-panel view components
    self.remainingArea = null;
    self.executedArea = null;

    // Main panel that holds everything
    self.panel = new JPanel(new BorderLayout());

    // Internal frame reference
    self.iframe = null;

    // === Helper Methods ===

    /**
     * Parse script text into ScriptLine objects.
     * Skips empty lines and comment-only lines.
     */
    parseScript(String scriptText) {
        self.lines.clear();
        self.currentIndex = 0;

        String[] rawLines = scriptText.split("\n");
        int lineNum = 0;

        for (int i = 0; i < rawLines.length; i++) {
            String trimmed = rawLines[i].trim();

            // Skip empty lines and comment-only lines
            if (trimmed.length() == 0) continue;
            if (trimmed.startsWith("//")) continue;

            lineNum++;
            self.lines.add(new ScriptLine(lineNum, rawLines[i]));
        }

        print("Loaded " + self.lines.size() + " lines.");
    }

    /**
     * Reset all lines to pending state.
     */
    resetExecution() {
        self.currentIndex = 0;
        for (int i = 0; i < self.lines.size(); i++) {
            ScriptLine line = (ScriptLine) self.lines.get(i);
            line.status = STATUS_PENDING;
            line.errorMessage = null;
        }
        refreshView();
        print("Execution reset.");
    }

    /**
     * Execute the current line and advance.
     */
    stepExecution() {
        if (self.currentIndex >= self.lines.size()) {
            print("Script complete.");
            return;
        }

        ScriptLine line = (ScriptLine) self.lines.get(self.currentIndex);
        line.status = STATUS_CURRENT;
        refreshView();

        try {
            // Use the shared BeanShell interpreter
            BeanShellService.get().eval(line.text);
            line.status = STATUS_COMPLETED;
        } catch (Exception e) {
            line.status = STATUS_ERROR;
            line.errorMessage = e.getMessage();
            print("Error at line " + line.lineNumber + ": " + e.getMessage());
        }

        self.currentIndex++;
        refreshView();

        // Scroll to show current line in table
        if (self.isTableView && self.table != null && self.currentIndex < self.lines.size()) {
            self.table.scrollRectToVisible(self.table.getCellRect(self.currentIndex, 0, true));
        }
    }

    /**
     * Refresh the current view.
     */
    refreshView() {
        if (self.isTableView) {
            if (self.tableModel != null) {
                self.tableModel.fireDataChanged();
            }
        } else {
            refreshTwoPanelView();
        }
    }

    /**
     * Refresh the two-panel view by rebuilding text areas.
     */
    refreshTwoPanelView() {
        if (self.remainingArea == null || self.executedArea == null) return;

        StringBuilder executed = new StringBuilder();
        StringBuilder remaining = new StringBuilder();

        for (int i = 0; i < self.lines.size(); i++) {
            ScriptLine line = (ScriptLine) self.lines.get(i);
            String prefix = "";
            if (STATUS_ERROR.equals(line.status)) {
                prefix = "[ERROR] ";
            }
            if (STATUS_COMPLETED.equals(line.status) || STATUS_ERROR.equals(line.status)) {
                executed.append(prefix).append(line.text).append("\n");
            } else if (STATUS_CURRENT.equals(line.status)) {
                remaining.append(">>> ").append(line.text).append("\n");
            } else {
                remaining.append(line.text).append("\n");
            }
        }

        self.executedArea.setText(executed.toString());
        self.remainingArea.setText(remaining.toString());
    }

    /**
     * Create the table view panel.
     */
    createTableView() {
        self.tableModel = new ScriptTableModel(self.lines);
        self.table = new JTable(self.tableModel);

        // Set up column renderers and widths
        TableColumnModel columnModel = self.table.getColumnModel();

        // Status column
        TableColumn statusCol = columnModel.getColumn(0);
        statusCol.setPreferredWidth(30);
        statusCol.setMaxWidth(40);
        statusCol.setCellRenderer(new StatusCellRenderer());

        // Line number column
        TableColumn lineNumCol = columnModel.getColumn(1);
        lineNumCol.setPreferredWidth(40);
        lineNumCol.setMaxWidth(60);
        lineNumCol.setCellRenderer(new LineNumberCellRenderer());

        // Code column
        TableColumn codeCol = columnModel.getColumn(2);
        codeCol.setCellRenderer(new CodeCellRenderer());

        // Table settings
        self.table.setRowHeight(20);
        self.table.setShowGrid(false);
        self.table.setIntercellSpacing(new Dimension(0, 0));
        self.table.getTableHeader().setReorderingAllowed(false);
        self.table.setRowSelectionAllowed(false);
        self.table.setCellSelectionEnabled(false);
        self.table.setFocusable(false);

        JScrollPane scrollPane = new JScrollPane(self.table);
        scrollPane.getViewport().setBackground(Color.WHITE);

        JPanel tablePanel = new JPanel(new BorderLayout());
        tablePanel.add(scrollPane, BorderLayout.CENTER);

        return tablePanel;
    }

    /**
     * Create the two-panel view.
     */
    createTwoPanelView() {
        // Remaining (pending) area - top
        self.remainingArea = new JTextArea(10, 60);
        self.remainingArea.setFont(new Font(Font.MONOSPACED, Font.PLAIN, 12));
        self.remainingArea.setEditable(true);
        JScrollPane remainingScroll = new JScrollPane(self.remainingArea);
        remainingScroll.setBorder(BorderFactory.createTitledBorder("Remaining"));

        // Executed area - bottom
        self.executedArea = new JTextArea(10, 60);
        self.executedArea.setFont(new Font(Font.MONOSPACED, Font.ITALIC, 12));
        self.executedArea.setEditable(false);
        self.executedArea.setBackground(new Color(230, 230, 230));
        JScrollPane executedScroll = new JScrollPane(self.executedArea);
        executedScroll.setBorder(BorderFactory.createTitledBorder("Executed"));

        JSplitPane splitPane = new JSplitPane(JSplitPane.VERTICAL_SPLIT,
            remainingScroll, executedScroll);
        splitPane.setDividerLocation(200);
        splitPane.setResizeWeight(0.5);

        JPanel twoPanelPanel = new JPanel(new BorderLayout());
        twoPanelPanel.add(splitPane, BorderLayout.CENTER);

        refreshTwoPanelView();

        return twoPanelPanel;
    }

    /**
     * Swap between table view and two-panel view.
     */
    swapView() {
        self.panel.remove(self.viewPanel);

        if (self.isTableView) {
            self.viewPanel = createTwoPanelView();
            self.isTableView = false;
        } else {
            self.viewPanel = createTableView();
            self.isTableView = true;
        }

        self.panel.add(self.viewPanel, BorderLayout.CENTER);
        self.panel.revalidate();
        self.panel.repaint();

        refreshView();
    }

    /**
     * Load a script from file.
     */
    loadScript() {
        JFileChooser chooser = new JFileChooser();
        chooser.setDialogTitle("Select BeanShell Script");
        String[] extensions = new String[] {"bsh", "java", "txt"};
        chooser.setFileFilter(new FileNameExtensionFilter("BeanShell Scripts", extensions));

        // Start in current directory
        chooser.setCurrentDirectory(new File(System.getProperty("user.dir")));

        int result = chooser.showOpenDialog(self.panel);
        if (result == JFileChooser.APPROVE_OPTION) {
            File file = chooser.getSelectedFile();
            try {
                StringBuilder sb = new StringBuilder();
                BufferedReader reader = new BufferedReader(new FileReader(file));
                String line;
                while ((line = reader.readLine()) != null) {
                    sb.append(line).append("\n");
                }
                reader.close();

                parseScript(sb.toString());
                refreshView();
                print("Loaded: " + file.getName());
            } catch (IOException e) {
                print("Error loading file: " + e.getMessage());
            }
        }
    }

    /**
     * Load script from text (for programmatic use).
     */
    loadScriptText(String scriptText) {
        parseScript(scriptText);
        refreshView();
    }

    /**
     * Paste script from system clipboard.
     */
    pasteFromClipboard() {
        try {
            Clipboard clipboard = Toolkit.getDefaultToolkit().getSystemClipboard();
            Transferable contents = clipboard.getContents(null);

            if (contents != null && contents.isDataFlavorSupported(DataFlavor.stringFlavor)) {
                String text = (String) contents.getTransferData(DataFlavor.stringFlavor);
                parseScript(text);
                refreshView();
                print("Pasted " + self.lines.size() + " lines from clipboard.");
            } else {
                print("Clipboard does not contain text.");
            }
        } catch (Exception e) {
            print("Error reading clipboard: " + e.getMessage());
        }
    }

    // === Action Handler ===
    actionPerformed(e) {
        String cmd = e.getActionCommand();

        if ("Step".equals(cmd)) {
            stepExecution();
        } else if ("Reset".equals(cmd)) {
            resetExecution();
        } else if ("Load".equals(cmd)) {
            loadScript();
        } else if ("Paste".equals(cmd)) {
            pasteFromClipboard();
        } else if ("Swap View".equals(cmd)) {
            swapView();
        } else if ("Close".equals(cmd)) {
            if (void != self.iframe) {
                self.iframe.hide();
            }
        }
    }

    // === Build UI ===

    // Create button panel
    self.buttonPanel = new JPanel(new FlowLayout(FlowLayout.LEFT));

    self.stepBtn = new JButton("Step");
    self.stepBtn.addActionListener(this);
    self.buttonPanel.add(self.stepBtn);

    self.resetBtn = new JButton("Reset");
    self.resetBtn.addActionListener(this);
    self.buttonPanel.add(self.resetBtn);

    self.loadBtn = new JButton("Load");
    self.loadBtn.addActionListener(this);
    self.buttonPanel.add(self.loadBtn);

    self.pasteBtn = new JButton("Paste");
    self.pasteBtn.addActionListener(this);
    self.buttonPanel.add(self.pasteBtn);

    self.swapBtn = new JButton("Swap View");
    self.swapBtn.addActionListener(this);
    self.buttonPanel.add(self.swapBtn);

    self.panel.add(self.buttonPanel, BorderLayout.NORTH);

    // Create initial view (table view)
    self.viewPanel = createTableView();
    self.panel.add(self.viewPanel, BorderLayout.CENTER);

    // Create the virtual app frame
    self.iframe = DesktopManager.get().createVApp(self.panel, title);

    // Set preferred size
    self.iframe.setSize(600, 400);

    print("Script Tester started. Use Load to open a script, then Step to execute.");

    return self;
}
