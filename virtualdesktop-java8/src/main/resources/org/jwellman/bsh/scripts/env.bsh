env() {
    if (global.env == void) global.env = this;

// ============== Enhanced env.bsh
    // --- SERVICE REGISTRATION ---
    // We nest our Big 6 inside env to keep the global namespace clean
    
    /**
     * web_service.bsh
     * Handles remote data retrieval and integration with the files service.
     */
     web_service() {

        this.verbose = true;

        download(urlString) {
            return new Object() {
                this.url = urlString;
                // Provider interface
                getStream() { return new java.net.URL(this.url).openStream(); }
                toString() { return this.url; }
                return this;
            };
        }
    
        /**
         * Downloads a file from a URL to a local destination.
         * If destination is a simple name, it uses files.resolve() automatically.
         */
        download(urlString, fileName) {
            import java.io.*;
            import java.net.*;
    
            // Integration point: Use the 'files' service to decide where this goes
            // We look for 'files' in the global scope or the env scope
            localPath = "";
            if (global.files != void) {
                localPath = global.files.resolve(fileName);
            } else {
                localPath = fileName; 
            }
    
            if (this.verbose) {
                print("→ Web: Starting download from " + urlString);
            }
    
            try {
                url = new URL(urlString);
                is = url.openStream();
                os = new FileOutputStream(localPath);
    
                byte[] buffer = new byte[4096];
                int n;
                while ((n = is.read(buffer)) != -1) {
                    os.write(buffer, 0, n);
                }
    
                os.close();
                is.close();
    
                if (this.verbose) {
                    print("✓ Web: Download complete -> " + localPath);
                }
                return localPath; // Return the path so it can be passed to readCSV
            } catch (e) {
                print("! Web Error: Download failed - " + e.getMessage());
                return null;
            }
        }
    
        /**
         * Simple GET request to return content as a String.
         * Useful for small JSON or Text files.
         */
        fetch(urlString) {
            import java.util.Scanner;
            import java.net.URL;
            
            try {
                url = new URL(urlString);
                s = new Scanner(url.openStream()).useDelimiter("\\A");
                result = s.hasNext() ? s.next() : "";
                return result;
            } catch (e) {
                print("! Web Error: Fetch failed - " + e.getMessage());
                return null;
            }
        }
    
        return this;
    }

    /**
     * files_service.bsh
     * Provides a stable, scoped namespace for filesystem operations.
     */
    files_service() {

        // --- State ---
        this.baseDir = System.getProperty("user.dir");
        this.verbose = true;
    
        // --- Methods ---
    
        // Improved internal helper
        _get(name) {
            file = new File(name);
            // If the user passed an absolute path, use it as-is.
            // Otherwise, resolve it against our baseDir.
            if (file.isAbsolute()) {
                return file;
            }
            return new File(this.baseDir, name);
        }
    
        /**
         * Asserts that a file exists and returns its absolute path.
         * Terminating the script if not found keeps the user's logic clean.
         */
        resolve(name) {
            f = _get(name);
            path = f.getAbsolutePath();
            
            if (!f.exists() || f.isDirectory()) {
                // Throwing an exception here stops the BeanShell script
                throw new RuntimeException("File not found or is a directory: " + path);
            }
            
            return path;
        }
    
        /**
         * Boolean check for conditional logic.
         */
        exists(name) {
            return _get(name).exists();
        }    

        create(provider, targetName) {
            import java.io.*;
            dest = new File(this.baseDir, targetName);
            
            try {
                is = provider.getStream();
                os = new FileOutputStream(dest);
                byte[] buf = new byte[4096];
                int n;
                while ((n = is.read(buf)) != -1) os.write(buf, 0, n);
                os.close(); is.close();
                
                print("✓ Files: Created " + dest.getName());
                return dest.getAbsolutePath();
            } catch (e) {
                throw new RuntimeException("Create failed: " + e.getMessage());
            }
        }
        
        /**
         * Standardized CSV Reader.
         * Returns a List of String arrays: List<String[]>
         */
        readCSV(filename) {
            import au.com.bytecode.opencsv.CSVReader;
            import java.io.FileReader;
            
            path = this.resolve(filename);
            try {
                reader = new CSVReader(new FileReader(path));
                allRows = reader.readAll();
                reader.close();
    
                if (this.verbose) {
                    print("✓ Files: Loaded " + allRows.size() + " rows.");
                }
                return allRows;
            } catch (e) {
                print("! Files Error: Could not read " + filename + " - " + e.getMessage());
                return null;
            }
        }
    
        /**
         * Updates the working directory.
         */
        setBase(path) {
            this.baseDir = path;
            if (this.verbose) print("✓ Files: Base directory updated to: " + path);
        }
    
        return this;
    }

    /**
     * db_service.bsh
     * Provides access to database connections from dbconfig.json
     */
    db_service() {
        import org.jwellman.virtualdesktop.config.ConfigStore;
        import org.jwellman.virtualdesktop.config.DbConfig;
        import org.jwellman.virtualdesktop.config.DbConnection;
        import java.sql.*;

        // --- State ---
        this.verbose = true;
        this.configStore = new ConfigStore("dbconfig.json", DbConfig.class);
        this.activeConnection = null; 

        // --- Methods ---

        /**
         * Get all configured connections
         */
        connections() {
            return this.configStore.get().getConnections();
        }

        /**
         * Get a connection config by name
         */
        getConfig(name) {
            for (conn : this.connections()) {
                if (conn.getName().equals(name)) return conn;
            }
            if (this.verbose) print("! DB: Connection '" + name + "' not found");
            return null;
        }

        /**
         * List all connection names
         */
        list() {
            print("╒════════════════════════════════");
            print("│   Database Connections");
            print(" ════════════════════════════════");
            for (conn : this.connections()) {
                print("  " + conn.getName() + " -> " + conn.getUrl());
            }
        }

        /**
         * Open a JDBC connection by config name
         */
        connect(name) {
            cfg = this.getConfig(name);
            if (cfg == null) return null;

            try {
                Class.forName(cfg.getDriver());
                con = DriverManager.getConnection(
                    cfg.getUrl(),
                    cfg.getUsername(),
                    cfg.getPassword()
                );
                if (this.verbose) print("✓ DB: Connected to " + name);
                return con;
            } catch (e) {
                print("! DB Error: " + e.getMessage());
                return null;
            }
        }

        /**
         * Reload config from disk
         */
        reload() {
            this.configStore.reload();
            if (this.verbose) print("✓ DB: Config reloaded");
        }

        // THE "NATURAL" WRAPPER (The Vision)

        use(name) {
            // Force the assignment to the outer scope variable
            con = this.connect(name);
            if (con != null) {
                activeConnection = con; // Set the service-level variable
            } else {
                throw new RuntimeException("DB Error: Connection '" + name + "' failed.");
            }
            return this;
        }

        /**
         * Performs a SELECT and returns a List of Maps.
         */
        query(sql) {
            if (this.activeConnection == void) throw new RuntimeException("No connection set!");
            
            import java.sql.*;
            import java.util.*;
    
            // Explicit cast inside the method for safety
            Connection con = (Connection) this.activeConnection;
            Statement stmt = null;
            ResultSet rs = null;

           java.util.List results = new ArrayList();
            try {
                stmt = con.createStatement();
                rs = stmt.executeQuery(sql);
                md = rs.getMetaData();
                cols = md.getColumnCount();
    
                while (rs.next()) {
                    Map row = new HashMap();
                    for (int i = 1; i <= cols; i++) {
                        row.put(md.getColumnLabel(i), rs.getObject(i));
                    }
                    results.add(row);
                }
                if (this.verbose) print("✓ Query returned " + results.size() + " rows.");

                // if you return results; here you get an error:
                // Error: EvalError: Void assignment
            } catch (e) {
                print("! Query Error: " + e.getMessage());
                throw e;
            } finally {
                try { if (rs != null) rs.close(); } catch (e) {}
                try { if (stmt != null) stmt.close(); } catch (e) {}
            }

            // ALWAYS return at the very end of the function scope
            return results;
        }
    
        /**
         * Performs an UPDATE/INSERT/DELETE or DDL
         */
        execute(sql) {
            if (this.activeConnection == void) throw new RuntimeException("No connection set!");
            
            // Explicit cast inside the method for safety
            import java.sql.*;
            Connection con = (Connection) this.activeConnection;
            Statement stmt = null;

            try {
                stmt = con.createStatement();
                count = stmt.executeUpdate(sql);
                if (this.verbose) print("✓ Execute successful. Rows affected: " + count);
                return count;
            } finally {
                if (stmt != null) stmt.close();
            }
        }

        /**
         * HSQLDB Special: Mounts a CSV directly as a table.
         */
        mountCSV(tableName, fileName) {
            path = files.resolve(fileName);
            // HSQLDB specific syntax
            this.execute("CREATE TEXT TABLE " + tableName + " (country VARCHAR(255), value DOUBLE)");
            this.execute("SET TABLE " + tableName + " SOURCE '" + path + ";fs=,'");
            if (this.verbose) print("✓ DB: CSV mounted as table " + tableName);
        }

        /**
         * Imports a List of String arrays (from readCSV) into a database table.
         * Automatically creates the table based on the first row (headers).
         */
        importData(tableName, dataList) {
            if (activeConnection == null || activeConnection == void) 
                throw new RuntimeException("No active connection.");
            if (dataList == null || dataList.isEmpty()) return 0;
    
            import java.sql.*;
            Connection con = (Connection) activeConnection;
            
            // 1. Extract Headers (Row 0)
            String[] headers = dataList.get(0);
            
            // 2. Auto-Create Table (Simple Approach)
            // We build a string like: CREATE TABLE t (col1 TEXT, col2 TEXT...)
            sb = new StringBuilder("CREATE TABLE " + tableName + " (");
            for (int i = 0; i < headers.length; i++) {
                // Sanitize header names (remove spaces/special chars)
                cleanHeader = headers[i].replaceAll("[^a-zA-Z0-9_]", "_");
                sb.append(cleanHeader + " VARCHAR(1000)");
                if (i < headers.length - 1) sb.append(", ");
            }
            sb.append(")");
            
            this.execute("DROP TABLE " + tableName + " IF EXISTS");
            this.execute(sb.toString());
    
            // 3. Prepare the INSERT statement
            // INSERT INTO table VALUES (?, ?, ?)
            insertSql = "INSERT INTO " + tableName + " VALUES (";
            for (int i = 0; i < headers.length; i++) {
                insertSql += "?";
                if (i < headers.length - 1) insertSql += ", ";
            }
            insertSql += ")";
    
            pstmt = con.prepareStatement(insertSql);
            
            count = 0;
            try {
                // Start from index 1 to skip the header row
                for (int i = 1; i < dataList.size(); i++) {
                    String[] row = dataList.get(i);
                    for (int j = 0; j < row.length; j++) {
                        pstmt.setString(j + 1, row[j]);
                    }
                    pstmt.addBatch();
                    count++;
                    
                    // Batch execution for performance
                    if (count % 500 == 0) pstmt.executeBatch();
                }
                pstmt.executeBatch(); // Final flush
                if (verbose) print("✓ DB: Imported " + count + " rows into " + tableName);
                return count;
            } finally {
                if (pstmt != null) pstmt.close();
            }
        }

        return this;
    }

    // Instantiate service objects
    this.web = web_service();
    this.files = files_service();
    this.db = db_service();

    // --- ALIAS EXPOSURE ---
    // We can "leak" these to the global level for convenience
    // but the 'real' versions live safely inside global.env
    global.web = this.web;
    global.files = this.files;
    global.db = this.db;




    // ======== original implementation ======================

    help() {
        for ( currentline : this.help ) {
          print(currentline);
        }
        getBshPrompt();
    }

    this.help = new ArrayList();
    help.add("");
    help.add("╒════════════════════════════════");
    help.add("│ Defining env() ...");
    help.add("│════════════════════════════════");
    help.add("│ ");
    help.add("│ Methods: ");

    help.add("│   d() ... display() ");
    display() {
        variables();
        methods();
        // methodnames();
        print("Note: Use methodnames() to get *just* method names\n");
    }

    // Alias for commonly used display() method
    d() { display(); }

    help.add("│   v() ... variables() ");
    variables() {
        print("╒════════════════════════════════");
        print("│   Variables");
        print(" ════════════════════════════════");
        sortandprint(global.namespace.getVariableNames());
    }

    // Alias for commonly used variables() method
    v() { variables(); }

    help.add("│   m() ... methods()");
    methods() {
        print("╒════════════════════════════════");
        print("│   Methods ");
        print(" ════════════════════════════════");
        print(global.namespace.getMethods());
    }

    // Alias for commonly used methods() method
    m() { methods(); }

    help.add("│   methodnames()");
    methodnames() {
        print("╒════════════════════════════════");
        print("│   Method Names ");
        print(" ════════════════════════════════");
        sortandprint(global.namespace.getMethodNames());
    }

    help.add("│   sortandprint*(String[])");
    sortandprint(String[] sortme) {
        Arrays.sort(sortme);
        for ( currentvar : sortme ) {
          print(currentvar);
        }
    }

        this.help.add("│ Services:");
        this.help.add("│   db       - Database connection management");
        this.help.add("│   web      - Remote resource management");
        this.help.add("│   files    - File system and path resolution");

    help.add("│ ");
    help.add("│════════════════════════════════");
    help.add("│ Reminder: env = env()");
    help.add(" ════════════════════════════════");

    this.help();
    this.display();

    return this;
}

