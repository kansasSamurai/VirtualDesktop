env() {
    if (global.env == void) global.env = this;

// ============== Enhanced env.bsh
    // --- SERVICE REGISTRATION ---
    // We nest our Big 6 inside env to keep the global namespace clean
    
    /**
     * web_service.bsh
     * Handles remote data retrieval and integration with the files service.
     */
     web_service() {

        this.verbose = true;

        download(urlString) {
            return new Object() {
                this.url = urlString;
                // Provider interface
                getStream() { return new java.net.URL(this.url).openStream(); }
                toString() { return this.url; }
                return this;
            };
        }
    
        /**
         * Downloads a file from a URL to a local destination.
         * If destination is a simple name, it uses files.resolve() automatically.
         */
        download(urlString, fileName) {
            import java.io.*;
            import java.net.*;
    
            // Integration point: Use the 'files' service to decide where this goes
            // We look for 'files' in the global scope or the env scope
            localPath = "";
            if (global.files != void) {
                localPath = global.files.resolve(fileName);
            } else {
                localPath = fileName; 
            }
    
            if (this.verbose) {
                print("→ Web: Starting download from " + urlString);
            }
    
            try {
                url = new URL(urlString);
                is = url.openStream();
                os = new FileOutputStream(localPath);
    
                byte[] buffer = new byte[4096];
                int n;
                while ((n = is.read(buffer)) != -1) {
                    os.write(buffer, 0, n);
                }
    
                os.close();
                is.close();
    
                if (this.verbose) {
                    print("✓ Web: Download complete -> " + localPath);
                }
                return localPath; // Return the path so it can be passed to readCSV
            } catch (e) {
                print("! Web Error: Download failed - " + e.getMessage());
                return null;
            }
        }
    
        /**
         * Simple GET request to return content as a String.
         * Useful for small JSON or Text files.
         */
        fetch(urlString) {
            import java.util.Scanner;
            import java.net.URL;
            
            try {
                url = new URL(urlString);
                s = new Scanner(url.openStream()).useDelimiter("\\A");
                result = s.hasNext() ? s.next() : "";
                return result;
            } catch (e) {
                print("! Web Error: Fetch failed - " + e.getMessage());
                return null;
            }
        }
    
        return this;
    }

    /**
     * files_service.bsh
     * Provides a stable, scoped namespace for filesystem operations.
     */
    files_service() {

        // --- State ---
        this.baseDir = System.getProperty("user.dir");
        this.verbose = true;
    
        // --- Methods ---
    
        // Improved internal helper
        _get(name) {
            file = new File(name);
            // If the user passed an absolute path, use it as-is.
            // Otherwise, resolve it against our baseDir.
            if (file.isAbsolute()) {
                return file;
            }
            return new File(this.baseDir, name);
        }
    
        /**
         * Asserts that a file exists and returns its absolute path.
         * Terminating the script if not found keeps the user's logic clean.
         */
        resolve(name) {
            f = _get(name);
            path = f.getAbsolutePath();
            
            if (!f.exists() || f.isDirectory()) {
                // Throwing an exception here stops the BeanShell script
                throw new RuntimeException("File not found or is a directory: " + path);
            }
            
            return path;
        }
    
        /**
         * Boolean check for conditional logic.
         */
        exists(name) {
            return _get(name).exists();
        }    

        create(provider, targetName) {
            import java.io.*;
            dest = new File(this.baseDir, targetName);
            
            try {
                is = provider.getStream();
                os = new FileOutputStream(dest);
                byte[] buf = new byte[4096];
                int n;
                while ((n = is.read(buf)) != -1) os.write(buf, 0, n);
                os.close(); is.close();
                
                print("✓ Files: Created " + dest.getName());
                return dest.getAbsolutePath();
            } catch (e) {
                throw new RuntimeException("Create failed: " + e.getMessage());
            }
        }
        
        /**
         * Standardized CSV Reader.
         * Returns a List of String arrays: List<String[]>
         */
        readCSV(filename) {
            import au.com.bytecode.opencsv.CSVReader;
            import java.io.FileReader;
            
            path = this.resolve(filename);
            try {
                reader = new CSVReader(new FileReader(path));
                allRows = reader.readAll();
                reader.close();
    
                if (this.verbose) {
                    print("✓ Files: Loaded " + allRows.size() + " rows.");
                }
                return allRows;
            } catch (e) {
                print("! Files Error: Could not read " + filename + " - " + e.getMessage());
                return null;
            }
        }
    
        /**
         * Updates the working directory.
         */
        setBase(path) {
            this.baseDir = path;
            if (this.verbose) print("✓ Files: Base directory updated to: " + path);
        }
    
        return this;
    }

    // Instantiate service objects
    this.web = web_service();
    this.files = files_service();

    // --- ALIAS EXPOSURE ---
    // We can "leak" these to the global level for convenience
    // but the 'real' versions live safely inside global.env
    global.web = this.web;
    global.files = this.files;


// ======== original implementation ======================


    help() {
        for ( currentline : this.help ) {
          print(currentline);
        }
        getBshPrompt();
    }

    this.help = new ArrayList();
    help.add("");
    help.add("╒════════════════════════════════");
    help.add("│ Defining env() ...");
    help.add("│════════════════════════════════");
    help.add("│ ");
    help.add("│ Methods: ");

    help.add("│   d() ... display() ");
    display() {
        variables();
        methods();
        // methodnames();
        print("Note: Use methodnames() to get *just* method names\n");
    }

    // Alias for commonly used display() method
    d() { display(); }

    help.add("│   v() ... variables() ");
    variables() {
        print("╒════════════════════════════════");
        print("│   Variables");
        print(" ════════════════════════════════");
        sortandprint(global.namespace.getVariableNames());
    }

    // Alias for commonly used variables() method
    v() { variables(); }

    help.add("│   m() ... methods()");
    methods() {
        print("╒════════════════════════════════");
        print("│   Methods ");
        print(" ════════════════════════════════");
        print(global.namespace.getMethods());
    }

    // Alias for commonly used methods() method
    m() { methods(); }

    help.add("│   methodnames()");
    methodnames() {
        print("╒════════════════════════════════");
        print("│   Method Names ");
        print(" ════════════════════════════════");
        sortandprint(global.namespace.getMethodNames());
    }

    help.add("│   sortandprint*(String[])");
    sortandprint(String[] sortme) {
        Arrays.sort(sortme);
        for ( currentvar : sortme ) {
          print(currentvar);
        }
    }

        this.help.add("│ Services:");
        this.help.add("│   web      - Remote resource management");
        this.help.add("│   files    - File system and path resolution");

    help.add("│ ");
    help.add("│════════════════════════════════");
    help.add("│ Reminder: env = env()");
    help.add(" ════════════════════════════════");

    this.help();
    this.display();

    return this;
}

// env = env();
