// --- STANDALONE DB TESTER ---
db_tester() {
    this.activeConnection = null;
    this.verbose = true;

    setConnection(con) {
        import java.sql.Connection;
        this.activeConnection = (Connection) con;
        if (this.verbose) print("✓ Tester: Connection set and cast to java.sql.Connection");
        return this;
    }

    query(sql) {
        if (this.activeConnection == void) throw new RuntimeException("No connection set!");
        
        import java.sql.*;
        import java.util.*;

        // Explicit cast inside the method for safety
        Connection con = (Connection) this.activeConnection;
        Statement stmt = null;
        ResultSet rs = null;

        try {
            stmt = con.createStatement();
            rs = stmt.executeQuery(sql);
            md = rs.getMetaData();
            cols = md.getColumnCount();

            java.util.List results = new ArrayList();
            while (rs.next()) {
                Map row = new HashMap();
                for (int i = 1; i <= cols; i++) {
                    row.put(md.getColumnLabel(i), rs.getObject(i));
                }
                results.add(row);
            }
            if (this.verbose) print("✓ Tester: Query returned " + results.size() + " rows.");
            return results;
        } catch (e) {
            print("! Query Error: " + e.getMessage());
            throw e;
        } finally {
            if (rs != null) rs.close();
            if (stmt != null) stmt.close();
        }
    }

    execute(sql) {
        if (this.activeConnection == void) throw new RuntimeException("No connection set!");
        
        import java.sql.*;
        Connection con = (Connection) this.activeConnection;
        Statement stmt = null;
        try {
            stmt = con.createStatement();
            count = stmt.executeUpdate(sql);
            if (this.verbose) print("✓ Tester: Execute successful. Rows affected: " + count);
            return count;
        } finally {
            if (stmt != null) stmt.close();
        }
    }

    return this;
}

// --- LIVE TEST EXECUTION ---
// 1. Initialize the tester
test = db_tester();


/**
 * Platform Sanity Check
 * Targets: DataSheet, bsh.This Bridge, and Primitive Unwrapping
 * 
 */
verify_platform() {
    import org.jwellman.bsh.DataSheet;

    print("--- STARTING PLATFORM VERIFICATION ---");

    // 1. Setup Mock Data
    rows = new ArrayList();
    r1 = new HashMap(); r1.put("ID", "A"); r1.put("VAL", 100); rows.add(r1);
    r2 = new HashMap(); r2.put("ID", "B"); r2.put("VAL", 200); rows.add(r2);
    
    ds = new DataSheet(rows);
    print("[1/3] DataSheet initialization: PASS");

    // 2. Test the "Transparent Bridge"
    // Define it as a function to satisfy the strict parser
    createFilter() {
        test(row) {
            // Use a simple check that returns a primitive boolean
            return "A".equals(row.get("ID"));
        }
        return this;
    }
    
    // Execute the function to get the bsh.This object
    filter_logic = createFilter();

    try {
        filtered = ds.filter(filter_logic);
        if (filtered.count() == 1) {
            print("[2/3] Filter Bridge (Primitive Unwrapping): PASS");
        } else {
            print("[FAIL] Filter Bridge: Expected 1 row, got " + filtered.count());
        }
    } catch (e) {
        print("[FAIL] Filter Bridge: " + e.getMessage());
    }

    // 3. Test Null Handling
    // This ensures your Java catch block doesn't just crash on bad data
    createNull() {
        test(row) { return row.get("NON_EXISTENT").equals("FAIL"); }
        return this;
    }
    null_logic = createNull();

// Do NOT use this syntax!!! Use the 'constructor' pattern above
//    new Object() {
//        test(row) { return row.get("NON_EXISTENT").equals("FAIL"); }
//    };

    try {
        none = ds.filter(null_logic);
        if (none.count() == 0) {
            print("[3/3] Null/Exception Handling: PASS");
        }
    } catch (e) {
        print("[FAIL] Null Handling: Platform crashed instead of returning false.");
        return;
    }

    print("--- ALL SYSTEMS GREEN ---");
    print("Platform is stable for 13k row processing.");
}

