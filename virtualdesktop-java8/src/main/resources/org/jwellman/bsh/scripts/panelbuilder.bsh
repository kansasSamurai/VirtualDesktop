// I haven't tested the following yet but it should 
// be mostly right:
panelbuilder() {

    var master = new JPanel(new BorderLayout());

    void add(container, component) {
        container.add(component);
        container.revalidate();
    }

    void add(container, component, constraint) {
        container.add(component, constraint);
        container.revalidate();
    }

    void move(component, destination, constraint) {
        var old = component.getParent();
        old.remove(component);
        if (constraint == null) {
            add(destination, component);
        } else {
            add(destination, component, constraint);
        }
        master.revalidate();
        master.repaint();
    }

    void createTool(String title) {
        DesktopManager.get().createVApp(master, title );
    }

    return this;
}

pb = panelbuilder();


