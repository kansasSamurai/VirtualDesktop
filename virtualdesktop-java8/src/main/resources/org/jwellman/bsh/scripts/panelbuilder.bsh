////////////////////////////////
// a version that draws text examples
////////////////////////////////

import java.awt.font.*/
import org.jwellman.swing.jpanel.tiles.*;


import org.jwellman.swing.jpanel.tiles.*;


proxy() {

    var background = new RectangleTile(500, 50).anchorTopLeft().anchorTo(100, 100);

    draw(g2d, area) {

        if (control.drawGrid) {
            g2d.setPaint(Color.darkGray);
            
            // Draw horizontal lines
            for (int y = 0; y < control.height; y += control.gridSize) {
                g2d.drawLine(0, y, control.width, y);
            }
    
            // Draw vertical lines
            for (int x = 0; x < control.width; x += control.gridSize) {
                g2d.drawLine(x, 0, x, control.height);
            }
            
        } else {
            g2d.setPaint(control.colorBackground);
            g2d.fillRect(0, 0, control.width, control.height);            
        }


        background.drawTile(g2d);

        String s = "Testing";
        int w = g2d.getFontMetrics().stringWidth(s) + 5;
        int h = g2d.getFontMetrics().getHeight();
        int d = g2d.getFontMetrics().getDescent();
        g2d.setFont(new Font("Segoe UI", Font.PLAIN, 24));
        g2d.setPaint(Color.cyan);
        g2d.drawString(s, 20, 50);
        g2d.drawString(s, 120, 50+h);
        g2d.drawString(s, 220, 50+h-d);
        g2d.setPaint(Color.yellow);
        g2d.drawLine(0,50, 320,50);

        center(g2d);
        example(g2d, new Font("Segoe UI", Font.PLAIN, 72), "X Testing Jj X");
    }
    
    center(g2) {
        var y = 100;
        paintHorizontallyCenteredText(g2, "come",   100, 75+y);
        paintHorizontallyCenteredText(g2, "and",    100, 125+y);
        paintHorizontallyCenteredText(g2, "play",   100, 175+y);        
    }

    paintHorizontallyCenteredText(Graphics2D g2, String s, float centerX, float baselineY) {
        FontRenderContext frc = g2.getFontRenderContext();
        Rectangle2D bounds = g2.getFont().getStringBounds(s, frc);
        float width = (float)bounds.getWidth();
        g2.drawString(s, centerX - width / 2, baselineY);
    }

    example(Graphics2D g2, Font font, String s) {
        // Font font = new Font("Serif", Font.PLAIN, 72);
        g2.setFont(font);

        float x = 250, y = 250;

        FontRenderContext frc = g2.getFontRenderContext();
        LineMetrics lm = font.getLineMetrics(s, frc);
        /*int*/ var bli = lm.getBaselineIndex();
        /*float[]*/ var offsets = lm.getBaselineOffsets();
        System.out.println("Leading: " + lm.getLeading());
        System.out.println("BaselineIndex: " + bli);
        for (int i=0; i<offsets.length; i++) {
            System.out.println("BaselineOffsets " + i + ": " + offsets[i]);
        }
        System.out.println("Strike Thickness: " + lm.getStrikethroughThickness());



        // Draw the bounds
        Rectangle2D bounds = g2.getFont().getStringBounds(s, frc);
        g2.setPaint(Color.green);
        Rectangle2D rect = new Rectangle2D.Double(x, y-bounds.getHeight()+lm.getDescent(), 
            bounds.getWidth(), bounds.getHeight());
        g2.draw(rect);

        // Draw the baseline.
        float width = (float)font.getStringBounds(s, frc).getWidth();
        Line2D baseline = new Line2D.Float(x, y, x + width, y);
        g2.setPaint(Color.red);
        g2.draw(baseline);
        
        // Draw the ascent.
        Line2D ascent = new Line2D.Float(x, y - lm.getAscent(),
            x + width, y - lm.getAscent());
        g2.draw(ascent);
        
        // Draw the descent.
        Line2D descent = new Line2D.Float(x, y + lm.getDescent(),
            x + width, y + lm.getDescent());
        g2.draw(descent);
        
        // Draw the leading.
        Line2D leading = new Line2D.Float(
            x, y + lm.getDescent() + lm.getLeading(),
            x + width, y + lm.getDescent() + lm.getLeading());
        g2.draw(leading);
        
        // Render the string.
        g2.setPaint(Color.lightGray);
        g2.drawString(s, x, y);    

        // Draw the vertical geometric center
        g2.setPaint(Color.green);
        float mid = (float)bounds.getCenterY();
        Line2D c = new Line2D.Float(x, y+mid, x+width, y+mid);
        g2.draw(c);
        
        // Draw the center baseline
        g2.setPaint(Color.cyan);
        var center = offsets[1];
        Line2D leading = new Line2D.Float(
            x, y + center,
            x + width, y + center);
        g2.draw(leading);
        
        // Draw the hanging baseline
        g2.setPaint(Color.magenta);
        var hanging = y + offsets[2];
        Line2D leading = new Line2D.Float(
            x, hanging,
            x + width, hanging);
        g2.draw(leading);

        // Draw the strikethrough
        g2.setPaint(Color.yellow);
        var strike = y + lm.getStrikethroughOffset();
        var line = new Line2D.Float( x, strike, x + width, strike);
        g2.draw(line);
        strike = strike - lm.getStrikethroughThickness();    
        line = new Line2D.Float( x, strike, x + width, strike);
        g2.draw(line);


    }

    return this;
}
proxy = proxy();

p.proxy = (org.jfree.chart.ui.Drawable)proxy;



















