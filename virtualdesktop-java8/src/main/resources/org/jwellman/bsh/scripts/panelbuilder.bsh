    // returns an array of Color[] objects
    parseColors(String colorString) {
        if (colorString == null || colorString.trim().isEmpty()) {
            return new Color[0];
        }
        
        // Split by comma and trim whitespace
        String[] hexColors = colorString.split(",");
        Color[] colors = new Color[hexColors.length];
        
        for (int i = 0; i < hexColors.length; i++) {
            colors[i] = parseHexColor(hexColors[i].trim());
        }
        
        return colors;
    }

    // returns a Color object
    parseHexColor(String hexColor) {
        if (hexColor == null) {
            throw new IllegalArgumentException("Color string cannot be null");
        }
        
        String hex = hexColor.trim();
        
        // Remove # if present
        if (hex.startsWith("#")) {
            hex = hex.substring(1);
        }
        
        // Validate format
        if (!hex.matches("^[0-9A-Fa-f]{3}$") && !hex.matches("^[0-9A-Fa-f]{6}$")) {
            throw new IllegalArgumentException("Invalid hex color format: " + hexColor);
        }
        
        // Handle 3-digit format (#RGB -> #RRGGBB)
        if (hex.length() == 3) {
            String r = hex.substring(0, 1);
            String g = hex.substring(1, 2);
            String b = hex.substring(2, 3);
            hex = r + r + g + g + b + b;
        }
        
        try {
            // Parse RGB components
            int rgb = Integer.parseInt(hex, 16);
            return new Color(rgb);
        } catch (NumberFormatException e) {
            throw new IllegalArgumentException("Invalid hex color format: " + hexColor, e);
        }
    }

    drawLeftCenteredStringPrecise(Graphics2D g2d, String text, int x, int y) {
        FontRenderContext frc = g2d.getFontRenderContext();
        Rectangle2D bounds = g2d.getFont().getStringBounds(text, frc);
        int textX = x; // (int) (x - bounds.getWidth() / 2);
        int textY = (int) (y - bounds.getHeight() / 2 - bounds.getY());
        g2d.drawString(text, textX, textY);
    }

    drawCenteredStringPrecise(Graphics2D g2d, String text, int x, int y) {
        FontRenderContext frc = g2d.getFontRenderContext();
        Rectangle2D bounds = g2d.getFont().getStringBounds(text, frc);
        int textX = (int) (x - bounds.getWidth() / 2);
        int textY = (int) (y - bounds.getHeight() / 2 - bounds.getY());
        g2d.drawString(text, textX, textY);
    }

}


























import java.awt.image.BufferedImage;

shape() {
    int imageWidth = 100;
    int imageHeight = 100;

    var transparent = new Color(0,0,0,0);
    var shadow = new Color(0,0,0,32);

    // Define the rounded rectangle properties
    int rectWidth = 50;
    int rectHeight = 50;
    int arcWidth = 20;
    int arcHeight = 20;

    draw() {
        // Create a BufferedImage to draw on
        BufferedImage bufferedImage = new BufferedImage(imageWidth, imageHeight, BufferedImage.TYPE_INT_ARGB);
        Graphics2D g2d = bufferedImage.createGraphics();
    
        // Optional: Set rendering hints for smoother drawing
        g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
    
        // Fill the background
        g2d.setColor(new Color(0,0,0,0)); // hopefully transparent
        g2d.fillRect(0, 0, imageWidth, imageHeight);    
    
        // Calculate the center point for rotation
        int centerX = imageWidth / 2;
        int centerY = imageHeight / 2;
    
        // Create the rounded rectangle shape
        RoundRectangle2D whiteRect = new RoundRectangle2D.Double(
            centerX - rectWidth / 2,
            centerY - rectHeight / 2,
            rectWidth, rectHeight,
            arcWidth, arcHeight
        );
        var shape = whiteRect;
        RoundRectangle2D shadowRect = new RoundRectangle2D.Double(
            centerX - rectWidth / 2 + 6,
            centerY - rectHeight / 2 - 2,
            rectWidth-4, rectHeight-4,
            arcWidth, arcHeight
        );
    
        double angle = Math.toRadians(45);
        g2d.rotate(angle, shape.getCenterX(), shape.getCenterY());
    
        g2d.setPaint(shadow);
        g2d.fill(shadowRect);
    
        g2d.setPaint(Color.white);
        g2d.fill(whiteRect);
    
        return bufferedImage;
        
    }

    return this;
}
shape = shape();
control.shape = shape.draw();



