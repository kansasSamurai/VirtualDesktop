// This creates a new DrawingSurface (no grid, no proxy, default shapes)
import java.awt.font.*;
import java.awt.geom.*;
import org.jfree.chart.ui.Drawable;
import org.jwellman.swing.jpanel.*;

p = new DrawingSurface();
DesktopManager.get().createVApp(p, "Drawing Surface");




control() {

    drawGrid = true; // when false, paint background with colorBackground
    drawHalo = true; // when true, draw the halo
    showPlacard = true; // when true, draw the placard
    showLabels = true; 
    barBackground = new Color(0xD0D4D5);
    colorBackground = new Color(0xE3E8E9);
    colorBackground = Color.white; // not yet used
    spacing = 80; // space between centers of bars
    horizontal = true; // horizontal bars or vertical

    font = new Font("Segoe UI", Font.BOLD, 12);
    labelFont = new Font("Segoe UI", Font.BOLD, 20);
    labelOffset = 15;
    // grid settings
    width = 901;
    height = 901;
    gridSize = 20;

    return this;
}
control = control();


