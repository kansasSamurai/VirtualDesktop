// Phase 9b exercise — SmartGrid + Blueprint DSL + BeanShell
// Run from the VirtualDesktop BeanShell console.
// _interpreter is the active console interpreter; scripts run in that context.
// NOTE: BeanShell does not support lambda expressions; anonymous classes are used instead.

import org.jwellman.swing.grid.ColumnDef;
import org.jwellman.swing.grid.DefaultGridComponentFactory;
import org.jwellman.swing.grid.DefaultGridModel;
import org.jwellman.swing.grid.GridRow;
import org.jwellman.swing.grid.ScriptBridge;
import org.jwellman.swing.grid.SmartGrid;

// --- 1. Build a model -------------------------------------------------------

DefaultGridModel model = new DefaultGridModel()
    .addColumn(new ColumnDef("id",        "ID",         50, false, true, null))
    .addColumn(new ColumnDef("timestamp", "Timestamp", 160, false, true, null))
    .addColumn(new ColumnDef("username",  "User",      140, false, true, null))
    .addColumn(new ColumnDef("type",      "Type",       80, false, true, null))
    .addColumn(new ColumnDef("detail",    "Detail",    200, false, true, null));

String[] types = {"INSERT", "UPDATE", "DELETE", "SELECT", "INSERT"};
String[] users = {"alice", "bob", "carol", "dave", "eve"};

for (int i = 1; i <= 60; i++) {
    String type = types[i % types.length];
    GridRow row = new GridRow()
        .put("id",        String.valueOf(i))
        .put("timestamp", "2026-05-13 " + String.format("%02d:%02d", new Object[]{i % 24, i % 60}))
        .put("username",  users[i % users.length])
        .put("type",      type)
        .put("detail",    "Table audit_log row " + i);
    if (type.equals("DELETE")) {
        row.setTag("fnd-type", "delete-event");
    }
    model.addRow(row);
}

// --- 2. Layout XML (flat format — no <column> wrappers needed) --------------

String layout = "<row>"
    + "<label id='ts'/>"
    + "<label id='user'/>"
    + "<label id='type'/>"
    + "<label id='detail'/>"
    + "</row>";

// --- 3. Bind and reset scripts — Style A (dark red) -------------------------

String bindA = ""
    + "import java.awt.Color; import javax.swing.JLabel;"
    + "self.setBackground(new Color(0x8B0000));"
    + "((JLabel) self.find(\"ts\")).setForeground(Color.WHITE);"
    + "((JLabel) self.find(\"ts\")).setText(row.get(\"timestamp\").toString());"
    + "((JLabel) self.find(\"user\")).setForeground(Color.WHITE);"
    + "((JLabel) self.find(\"user\")).setText(row.get(\"username\").toString());"
    + "((JLabel) self.find(\"type\")).setForeground(new Color(0xFF8080));"
    + "((JLabel) self.find(\"type\")).setText(row.get(\"type\").toString());"
    + "((JLabel) self.find(\"detail\")).setForeground(Color.WHITE);"
    + "((JLabel) self.find(\"detail\")).setText(row.get(\"detail\").toString());";

String reset = ""
    + "import javax.swing.JLabel;"
    + "self.setBackground(java.awt.Color.WHITE);"
    + "((JLabel) self.find(\"ts\")).setText(\"\");"
    + "((JLabel) self.find(\"user\")).setText(\"\");"
    + "((JLabel) self.find(\"type\")).setText(\"\");"
    + "((JLabel) self.find(\"detail\")).setText(\"\");";

// --- 4. Style B (amber/orange) — registered later by the "Change Style" button

String bindB = ""
    + "import java.awt.Color; import javax.swing.JLabel;"
    + "self.setBackground(new Color(0x7A4000));"
    + "((JLabel) self.find(\"ts\")).setForeground(new Color(0xFFE0A0));"
    + "((JLabel) self.find(\"ts\")).setText(row.get(\"timestamp\").toString());"
    + "((JLabel) self.find(\"user\")).setForeground(new Color(0xFFE0A0));"
    + "((JLabel) self.find(\"user\")).setText(row.get(\"username\").toString());"
    + "((JLabel) self.find(\"type\")).setForeground(new Color(0xFFD700));"
    + "((JLabel) self.find(\"type\")).setText(\"! \" + row.get(\"type\").toString());"
    + "((JLabel) self.find(\"detail\")).setForeground(new Color(0xFFE0A0));"
    + "((JLabel) self.find(\"detail\")).setText(row.get(\"detail\").toString());";

// --- 5. Create grid, bridge, factory ----------------------------------------

SmartGrid grid = new SmartGrid(model, true);

ScriptBridge bridge = new ScriptBridge(grid, _interpreter);
DefaultGridComponentFactory gridFactory = new DefaultGridComponentFactory(grid, _interpreter);

// Register Style A — BeanShell-friendly: no Supplier or lambda needed
gridFactory.create("delete-event", layout, bindA, reset, bridge);

// --- 6. Show window with a "Change Style" button ----------------------------

javax.swing.JPanel toolbar = new javax.swing.JPanel(new java.awt.FlowLayout(java.awt.FlowLayout.LEFT));

javax.swing.JLabel styleLabel = new javax.swing.JLabel("DELETE rows: Style A (dark red)");
toolbar.add(styleLabel);

javax.swing.JButton changeBtn = new javax.swing.JButton("Switch to Style B (amber)");
changeBtn.addActionListener(new java.awt.event.ActionListener() {
    public void actionPerformed(java.awt.event.ActionEvent e) {
        // Re-register the same key with a different script — live runtime swap
        gridFactory.create("delete-event", layout, bindB, reset, bridge);
        // model.notifyDataChanged() fires the model listener which triggers SmartGrid's refresh()
        model.notifyDataChanged();
        styleLabel.setText("DELETE rows: Style B (amber)");
        changeBtn.setEnabled(false);
        print("Re-registered 'delete-event' with Style B. Pool replaced; next refresh uses new renderer.");
    }
});
toolbar.add(changeBtn);

javax.swing.JPanel content = new javax.swing.JPanel(new java.awt.BorderLayout());
content.add(toolbar, java.awt.BorderLayout.NORTH);
content.add(grid, java.awt.BorderLayout.CENTER);

javax.swing.JFrame f = new javax.swing.JFrame("Phase 9b — Scripted Rows (Live Swap Demo)");
f.setDefaultCloseOperation(javax.swing.JFrame.DISPOSE_ON_CLOSE);
f.setSize(720, 460);
f.add(content);
f.setLocationRelativeTo(null);
f.setVisible(true);

print("Grid open. DELETE-type rows use Style A (dark red).");
print("Click 'Switch to Style B' to re-register the renderer live.");
